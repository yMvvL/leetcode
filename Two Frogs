//Two Frogs
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int main(){
	IOS;
	int t;
	cin>>t;
	vector<int> n(t),a(t),b(t);
	for(itn i=0;i<t;i++){
		cin>>n[i]>>a[i]>>b[i];
	}
	for(int i=0;i<t;i++){
		if(abs(a[i]-b[i])%2==1){
			cout<<"NO"<<endl;
		}
		else{
			cout<<"YES"<<endl;
		}
	}
	return 0;
} 
