//打暴力
class Solution {
public:
    vector<string> summaryRanges(vector<int>& nums) {
        int n=nums.size();
        vector<string> ret;
        int i=0;
        while(i<n){
            int low=i;
            i++;
            while(i<n&&nums[i]==nums[i-1]+1){
                i++;
            }
            int high=i-1;
            string temp=to_string(nums[low]);
            if(low<high){
                temp+="->";
                temp+=to_string(nums[high]);
            }
            ret.push_back(temp);   
        }
        return ret;
    }
};
