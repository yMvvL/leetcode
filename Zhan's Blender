#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main() {
	IOS;
	int t;
	cin >> t;
	vector<int> n(t), x(t), y(t);
	for (int i = 0; i < t; i++) {
		cin >> n[i] >> x[i] >> y[i];
	}
	for (int i = 0; i < t; i++){
		if (n[i] % min(x[i], y[i])) {
			cout << n[i] / min(x[i], y[i]) + 1 << endl;
		} else {
			cout << n[i] / min(x[i], y[i]) << endl;
		}
	}
	return 0;
}
