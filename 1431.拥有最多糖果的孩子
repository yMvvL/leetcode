class Solution {
private:
    int find_max(vector<int>& a){//找出数组中的最大值
        int max=-1;
        for(int i=0;i<a.size();i++){
            if(max<a[i]){
                max=a[i];
            }
        }
        return max;
    }
public:
    vector<bool> kidsWithCandies(vector<int>& candies, int extraCandies) {
        int n=candies.size();
        int max=find_max(candies);
        vector<bool> ans;
        for(int i=0;i<n;i++){
            if(candies[i]+extraCandies>=max){//如果加起来比最大值大的话就加一个true，否则加false
                ans.push_back(true);
            }
            else{
                ans.push_back(false);
            }
        }
        return ans;
    }
};
