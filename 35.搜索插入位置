//二分查找
class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int n=nums.size();
        int left=0,right=n-1,ans=n;
        while(left<=right){
            int mid=((right-left)>>1)+left;//确定新的边界
            if(target<=nums[mid]){//等于的情况也判断，这样每次都运行到left=right之后结束
                ans=mid;
                right=mid-1;//改变边界
            }
            else{
                left=mid+1;//改变边界
            }
        }
        return ans;
    }
};
