class Solution {
public:
    int searchInsert(vector<int>& nums, int target) {
        int n=nums.size();
        int left=0,right=nums.size()-1;
        if(target>nums[n-1]){
            return n;
        }
        if(target<nums[0]){
            return 0;
        }
        while(left<right){
            if(left+1==right&&nums[left]<target&&nums[right]>target){
                return left;
            }
            int mid=(right-left)/2+left;
            if(nums[mid]==target){
                return mid;
            }
            else if(nums[mid]<target){
                left=mid+1;
            }
            else{
                right=mid;
            }
            if(left+1==right&&nums[left]<target&&nums[right]>target){
                return left;
            }
        }
        return 2;
    }
};
