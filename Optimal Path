//Optimal Path
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main() {
	IOS;
	int t, m, n;
	cin >> t;
	vector<ll> ans(t, 0);
	for (int i = 0; i < t; i++) {

		cin >> n >> m;

		for (int j = 2; j <= n; j++) {
			ans[i] += j * m;
		}
		for (int j = 1; j <= m; j++) {
			ans[i] += j;
		}
	}
	for (int i = 0; i < t; i++) {
		cout << ans[i] << endl;
	}
	return 0;
}
