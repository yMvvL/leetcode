//常规二分，让你干啥你干啥就行了
class Solution {
public:
    bool checkIfExist(vector<int>& arr) {
        sort(arr.begin(),arr.end());
        for(int i=arr.size()-1;i>=0;i--){
            int l=0,r=arr.size()-1,ans=0;
            while(l<=r){
                int mid=((r-l)>>1)+l;
                if(arr[mid]*2<=arr[i]){
                    ans=mid;
                    l=mid+1;
                }
                else{
                    r=mid-1;
                }   
            }
            if(arr[ans]*2==arr[i]&&ans>=0&&ans!=i){//注意这里判断一下ans!=i
                return true;
            }
        }
        return false;
    }
};
