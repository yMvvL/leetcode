//Special Permutation
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int main(){
	IOS;	
	int n;
	cin>>n;
	vector<int> nums(n);
	vector<vector<int>> ans(n);
	for(itn i=0;i<n;i++){
		cin>>nums[i];
	}
	for(int i=0;i<n;i++){
		for(int j=2;j<=nums[i];j++){
			ans[i].push_back(j);
		}
		ans[i].push_back(1);
	}
	for(int i=0;i<n;i++){
		for(int j=0;j<ans[i].size();j++){
			cout<<ans[i][j]<<" ";
		}
		cout<<endl;
	}
	return 0;
}
