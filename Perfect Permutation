//Perfect Permutation
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main(){
	IOS;
	int t;
	cin>>t;
	vector<int> n(t);
	vector<vector<int>> ans(t);
	for(int i=0;i<t;i++){
		cin>>n[i];
	}
	for(int i=0;i<t;i++){
		int num=n[i];
		for(int j=0;j<n[i];j++){
			ans[i].push_back(num);
			if(j==0){
				num=1;
				continue;
			}
			num++;
		}
	}
	for(int i=0;i<t;i++){
		for(int j=0;j<n[i];j++){
			cout<<ans[i][j]<<" ";
		}
		cout<<endl;
	}
	return 0; 
} 
