//MEXanized Array
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int main(){
	IOS;
	int t;
	cin>>t;
	vector<int> n(t),k(t),x(t);
	vector<int> ans(t,0);
	for(int i=0;i<t;i++){
		cin>>n[i]>>k[i]>>x[i];
	}
	for(int i=0;i<t;i++){
		if(min(x[i]+1,n[i])<k[i]){
			ans[i]=-1;
		}
		else{
			if(k[i]==x[i]){
				for(int j=0;j<n[i];j++){
					if(j<=k[i]-1){
						ans[i]+=j;
					}
					else{
						ans[i]+=k[i]-1;
					}
				}
			}
			if(k[i]!=x[i]){
				for(itn j=0;j<n[i];j++){
					if(j<=k[i]-1){
						ans[i]+=j;
					}
					else{
						ans[i]+=x[i];
					}
				}
			}
		}
	}
	for(int i=0;i<t;i++){
		cout<<ans[i]<<endl;
	}
	return 0;
} 
