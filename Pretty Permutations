//Pretty Permutations
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0), cin.tie(0), cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main() {
	IOS;
	int t;
	cin >> t;
	vector<int> n(t);

	for (int i = 0; i < t; i++) {
		cin >> n[i];
	} 

	for (int i = 0; i < t; i++) {
		if (n[i] == 2) {
			cout << "2" << " "  << "1" << endl;
			continue;
		} 
		if (n[i] >= 3 && n[i] % 2) {
			cout << "2 " << "3 " << "1 ";

			for (int j = 4, k = 5; j <= n[i] || k <= n[i]; j += 2, k += 2) {
				if (k <= n[i]) {
					cout << k << " ";
				}
				if (j <= n[i]) {
					cout << j << " ";
				}
			}
		} else {
			for (int j = 1, k = 2; j <= n[i] || k <= n[i]; j += 2, k += 2) {
				if (k <= n[i]) {
					cout << k << " ";
				}
				if (j <= n[i]) {
					cout << j << " ";
				}
			}
		}
		cout<<endl;
	}
	return 0;
}
