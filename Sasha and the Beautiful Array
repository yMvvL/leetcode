//Sasha and the Beautiful Array
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int main(){
	IOS;
	int t;
	cin>>t;
	vector<int> n(t);
	vector<vector<int>> a(t);
	vector<int> ans(t);
	for(int i=0;i<t;i++){
		cin>>n[i];
		a[i].resize(n[i]);
		for(int j=0;j<a[i].size();j++){
			cin>>a[i][j];
		}
		sort(a[i].begin(),a[i].end());
		ans[i]=a[i][a[i].size()-1]-a[i][0];
	}
	for(int i=0;i<t;i++){
		cout<<ans[i]<<endl;
	}
	return 0;
}
