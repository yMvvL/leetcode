class Solution {
public:
    int search(vector<int>& nums, int target) {
        int left=0,right=nums.size()-1,ans=-1;
        while(left<=right){
            int mid=((right-left)>>1)+left;
            if(mid>=0&&nums[mid]<=target){
                ans=mid;
                left=mid+1;
            }
            else{
                right=mid-1;
            }
        }
        if(ans>=0&&nums[ans]!=target){
            return -1;
        }
        return ans;
    }
};
