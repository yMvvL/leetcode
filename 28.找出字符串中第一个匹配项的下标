class Solution {
public:
    int strStr(string haystack, string needle) {
        int n=haystack.size();
        int m=needle.size();//记录数组长度
        for(int i=0;i+m<=n;i++){//短的长度和当前位置之和应该小于长的长度
            bool flag=true;
            for(int j=0;j<m;j++){
                if(haystack[i+j]!=needle[j]){//从第i+1个开始，逐步判断j个元素是否分别相等
                    flag=false;
                    break;
                }
            }
            if(flag){//如果有相等直接return i
                return i;
            }
        }
        return -1;//没有就返回-1
    }
};
