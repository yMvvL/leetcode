//打暴力
class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
        vector<int> ans;
        int flag=1;
        for(int i=0;i<nums.size();i++){
            if(flag==0){
                break;
            }
            for(int j=1;j<nums.size();j++){
                if(nums[i]+nums[j]==target&&i!=j){
                    ans.push_back(i);
                    ans.push_back(j);
                    flag=0;
                    break;
                }
            }
        }
        return ans;
    }
};
