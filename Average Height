//Average Height
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int main(){
	IOS;
	int n;
	cin>>n;
	vector<int> nums(n);
	vector<vector<int>> heights(n);
	for(int i=0;i<n;i++){
		cin>>nums[i];
		heights[i].resize(nums[i]);
		for(itn j=0;j<nums[i];j++){
			cin>>heights[i][j];
		}
	}
	vector<vector<int>> ans(n);
	for(int i=0;i<n;i++){
		for(int j=0;j<nums[i];j++){
			if(heights[i][j]%2==1){
				ans[i].push_back(heights[i][j]);
			}
		}
	}
	for(int i=0;i<n;i++){
		for(int j=0;j<nums[i];j++){
			if(heights[i][j]%2==0){
				ans[i].push_back(heights[i][j]);
			}
		}
	}
	for(itn i=0;i<n;i++){
		for(int j=0;j<ans[i].size();j++){
			cout<<ans[i][j]<<" ";
		}
		cout<<endl;
	}
	return 0;
} 
