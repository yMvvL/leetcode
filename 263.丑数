class Solution {
public:
    bool isUgly(int n) {
        if(n<=0){
            return false;
        }
        while(n%2==0){//如果是2的倍数就一直除以2直到除不了为止
            n/=2;
        }
        while(n%3==0){
            n/=3;
        }
        while(n%5==0){
            n/=5;
        }
        return n==1;
    }
};
