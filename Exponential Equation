//Exponential Equation
//令其中一个为1即可
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0), cin.tie(0), cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main() {
	IOS;
	ll t, n;
	cin >> t;
	for (int i = 0; i < t; i++) {
		cin >> n;
		if (n % 2) {
			cout << -1 << endl;
		} else {
			cout << 1 << " " << n / 2 << endl; 
		}
	}
	return 0;
}
