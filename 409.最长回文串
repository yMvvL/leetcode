class Solution {
public:
    int longestPalindrome(string s) {
        unordered_map<char,int> Hashmap,check;
        int flag=0,ans=0;
        for(int i=0;i<s.size();i++){
            Hashmap[s[i]]++;
        }
        for(int i=0;i<s.size();i++){
            if(Hashmap[s[i]]%2==1&&flag==0){
                flag=1;
                ans++;
            }
            if(Hashmap[s[i]]>=2&&check[s[i]]==0){
                if(Hashmap[s[i]]%2==0) ans+=Hashmap[s[i]];
                if(Hashmap[s[i]]%2==1)
                ans+=Hashmap[s[i]]-1;
                check[s[i]]=1;
            }
        }
        return ans;
    }
};
