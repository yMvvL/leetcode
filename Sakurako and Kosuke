#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int main(){
	IOS;
	itn n;
	cin>>n;
	vector<int> nums(n);
	for(int i=0;i<n;i++){
		cin>>nums[i];
	}
	for(int i=0;i<n;i++){
		if(nums[i]%2==1){
			cout<<"Kosuke"<<endl;
		}
		else{
			cout<<"Sakurako"<<endl;
		}
	}
	return 0;
} 
