class Solution {
public:
    bool isPerfectSquare(int num) {
        //二分查找
        int left=0,right=num,ans;
        if(num==0||num==1){
            return true;
        }
        while(left<=right){
            int mid=((right-left)>>1)+left;
            if(mid<=num/mid){
                ans=mid;
                left=mid+1;
            }
            else{
                right=mid-1;
            }
        }
        return (ans*ans==num);//注意最后判断要用a*a==b
    }
};
