//纯暴力解法
class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        vector<int> ans;
        unordered_map<int,int> Hashmap;
        for(int i=0;i<nums.size();i++){
            Hashmap[nums[i]]++;
        }
        for(int i=1;i<=nums.size();i++){
            if(Hashmap[i]==0){
                ans.push_back(i);
            }
        }
        return ans;
    }
};
//比较巧妙的思路：原地哈希
class Solution {
public:
    vector<int> findDisappearedNumbers(vector<int>& nums) {
        int n=nums.size();
        for(auto& num:nums){
            int x=(num-1)%n;
            if(nums[x]<=n){
                nums[x]+=n;
            }
        }
        vector<int> ret;
        for(int i=0;i<n;i++){
            if(nums[i]<=n){
                ret.push_back(i+1);
            }
        }
        return ret;
    }
};
