//The Third Three Number Problem
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main(){
	IOS;
	int t;
	cin >> t;
	vector<ll> n(t);
	for(int i=0;i<t;i++){
		cin>>n[i];
	}
	for(int i=0;i<t;i++){
		if(n[i]%2){
			cout<<-1<<endl;
		}
		else{
			cout<<n[i]/2<<" "<<0<<" "<<0<<endl;
		}
	}
	return 0;
}
