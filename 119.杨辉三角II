//非常巧妙的思路
class Solution {
public:
    vector<int> getRow(int rowIndex) {
        vector<int> ans(rowIndex+1);
        ans[0]=1;
        for(int i=1;i<=rowIndex;i++){
            for(int j=i;j>0;j--){
                ans[j]+=ans[j-1]; 
            }
        }
        //过程是这样的：
        //  1 2 1
        // 1 2 1 0
        //下一步：从右往左遍历，每个数据加它左上角的那个数
        // 1 2 1 1
        // 1 2 3 1
        // 1 3 3 1
        //每一步都是同理
        return ans;
    }
};
