//Digit Minimization
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int
#define vetcor vector
#define asn ans

int main(){
	IOS;
	itn t;
	cin>>t;
	vector<string> s(t);
	for(int i=0;i<t;i++){
		cin>>s[i];
		if(s[i].size()==2&&s[i][0]>s[i][1]){
			cout<<s[i][1]<<endl;
			continue;
		}
		if(s[i].size()==2&&s[i][0]<s[i][1]){
			cout<<s[i][1]<<endl;
			continue;
		}
		sort(s[i].begin(),s[i].end());
		cout<<s[i][0]<<endl;
	}
	return 0; 
} 
