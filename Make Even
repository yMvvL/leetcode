//Make Even
//思路是判断首位是偶数就1次，整个是偶数是0次，首位不是偶数，中间有一位是偶数是2次，全是奇数就-1
#include<bits/stdc++.h>
#include<climits>
using namespace std;
#define ll long long
#define IOS ios::sync_with_stdio(0),cin.tie(0),cout.tie(0)
#define itn int

int times(int x){
	int flag=0;
	while(x){
		if(x/10==0&&x%2==0){
			return 1;
		}
		if(x%10%2==0){
			flag=1;
		}
		x/=10;
	}
	if(flag==1){
		return 2;
	}
	return -1;
}

int main(){
	IOS;
	itn t;
	cin>>t;
	vector<int> n(t);
	vector<int> ans(t);
	for(int i=0;i<t;i++){
		cin>>n[i];
		if(n[i]%2==0){
			ans[i]=0;
		}
		else{
			ans[i]=times(n[i]);
		}
	}
	for(int i=0;i<t;i++){
		cout<<ans[i]<<endl;
	}
	return 0;
} 
