class Solution {
public:
    vector<vector<int>> generate(int numRows) {
        vector<vector<int>> ans(numRows);
        for(int i=0;i<numRows;i++){
            ans[i].resize(i+1);//第i个数组应该有i+1个数，所以这里应该resize一下
            ans[i][0]=ans[i][i]=1;//把第一个数和最后一个数设置成1
            for(int j=1;j<i;j++){
                ans[i][j]=ans[i-1][j]+ans[i-1][j-1];//每个数设置成上面两个数的和
            }
        }   
        return ans;
    }
};
