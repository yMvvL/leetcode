//常规暴力哈希
class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        unordered_map<char,int> Hashmap1,Hashmap2;
        int n1=ransomNote.size(),n2=magazine.size();
        for(int i=0;i<n1;i++){
            Hashmap1[ransomNote[i]]++;
        }
        for(int i=0;i<n2;i++){
            Hashmap2[magazine[i]]++;
        }
        for(int i=0;i<n1;i++){
            if(Hashmap2[ransomNote[i]]<Hashmap1[ransomNote[i]]){
                return false;
            }
        }
        return true;
    }
};
//只开一个哈希表解决问题，本质还是比较相同字母的个数
class Solution {
public:
    bool canConstruct(string ransomNote, string magazine) {
        unordered_map<char,int> Hashmap;
        int n1=ransomNote.size(),n2=magazine.size();
        //只记录ransomNote里的，之后magazine里找到一个就减1，如果减到负数了就返回false
        for(int i=0;i<n2;i++){
            Hashmap[magazine[i]]++;
        }
        for(int i=0;i<n1;i++){
            Hashmap[ransomNote[i]]--;
            if(Hashmap[ransomNote[i]]<0){
                return false;
            }
        }
        return true;
    }
};
